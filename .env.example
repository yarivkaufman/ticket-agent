# Copy to .env on the server (never commit .env, never put it in OneDrive)
# Reads your event request ("Knicks vs Portland at MSG Nov 21, 3 tickets, max $120").
# Empty = a simple built-in reader (works for "Team vs Team Mon DD, N tickets, $X").
ANTHROPIC_API_KEY=
# SeatGeek Platform API: seatgeek.com/account/develop > Create an app > Client ID. Required.
SEATGEEK_CLIENT_ID=
# Client Secret from the same SeatGeek app page. Optional; sent along with the client id.
SEATGEEK_CLIENT_SECRET=
# Ticketmaster Discovery API: developer.ticketmaster.com > My Apps > Consumer Key. Optional (face value info).
TICKETMASTER_API_KEY=
# Email alerts. Gmail: smtp.gmail.com / 587, SMTP_USER = the agent's Gmail address,
# SMTP_PASSWORD = a 16-character app password (myaccount.google.com/apppasswords; needs 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown on alerts (default: SMTP_USER). Recipients: comma-separated.
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=yariv@kaufmanweb.net
# Maintenance/failure messages. Empty = log + /runs page only.
ADMIN_EMAIL=
LOG_LEVEL=INFO
